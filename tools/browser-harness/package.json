{
  "name": "@clubscape/browser-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test --test-reporter=spec tests/unit.test.ts",
    "test:browser": "node src/desktop.ts --test --test-reporter=spec tests/browser.test.ts",
    "smoke": "node src/desktop.ts src/cli.ts --config config/fixture.json --tool-fixture",
    "capture": "node src/desktop.ts src/cli.ts",
    "fixture": "node src/fixture-server.ts"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "pngjs": "7.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2"
  }
}
